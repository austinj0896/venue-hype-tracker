# Streamlit Community Cloud: App settings -> Secrets (paste entire block).
# Local: copy to secrets.toml in this folder (never commit secrets.toml).

[connections.snowflake]
# Same value as SNOWFLAKE_ACCOUNT in your local .env, e.g. xy12345.us-east-1
# If login fails, try org-account form from Snowsight -> Account -> Account identifier.
account = "YOUR_ACCOUNT_IDENTIFIER"
user = "VENUE_SWIPER_SVC"
password = "YOUR_SERVICE_USER_PASSWORD"
role = "VENUE_SWIPER_APP"
warehouse = "VENUE_HYPE_WH"
database = "VENUE_HYPE"
schema = "APP"
