# Streamlit Community Cloud: App settings -> Secrets (paste entire file).
# Local: copy to secrets.toml in this folder (never commit secrets.toml).

# --- Neon Postgres (recommended for free shared hosting) ---
[app]
database_backend = "postgres"

[connections.postgresql]
url = "postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional table names (defaults: places, venue_ratings)
# places_table = "places"
# ratings_table = "venue_ratings"

# Optional: OpenRouteService API key (free at https://openrouteservice.org/dev/#/signup)
# Improves walk-time accuracy between date stops. Without it, straight-line estimates are used.
# ors_api_key = "YOUR_ORS_API_KEY"

# Optional: table for saved date plans (default planned_dates)
# planned_dates_table = "planned_dates"

# --- Snowflake (Streamlit in Snowflake, or legacy Community Cloud) ---
# Remove [connections.postgresql] and set database_backend = "snowflake" to use this.
#
# [app]
# database_backend = "snowflake"
# dim_places = "VENUE_HYPE.STAGING_MARTS.DIM_PLACES"
# ratings_table = "VENUE_HYPE.APP.VENUE_RATINGS"
#
# [connections.snowflake]
# account = "YOUR_ACCOUNT_IDENTIFIER"
# user = "VENUE_SWIPER_SVC"
# password = "YOUR_SERVICE_USER_PASSWORD"
# role = "VENUE_SWIPER_APP"
# warehouse = "VENUE_HYPE_WH"
# database = "VENUE_HYPE"
# schema = "APP"
